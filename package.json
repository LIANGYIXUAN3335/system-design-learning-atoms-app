    "build:deck": "node scripts/build-deck.mjs",
    "visual:audit": "node scripts/visual-audit.mjs",
    "visual:validate": "node scripts/validate-visuals.mjs",
    "quality:audit": "node scripts/audit-card-quality.mjs",
    "backfill": "node scripts/content-quality-backfill-cron.mjs",
    "backfill:dry": "node scripts/content-quality-backfill-cron.mjs --dry-run"
  },
  "private": true
}
