{
  "name": "atoms-app",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~57.0.1",
    "expo-asset": "~57.0.2",
    "expo-file-system": "~57.0.0",
    "expo-notifications": "~57.0.2",
    "expo-speech": "~57.0.0",
    "expo-sqlite": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "ts-fsrs": "^5.4.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "jsdom": "^29.1.1",
    "mermaid": "^11.16.0",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
