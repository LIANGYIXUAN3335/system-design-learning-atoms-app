# Set these only for your private deployment. The server rejects requests
# without the same bearer token.
EXPO_PUBLIC_ATOM_SYNC_URL=https://YOUR-CLOUD-RUN-URL
# Native builds may also receive the token at build time. Web builds ask for it
# once in the browser and keep it in that browser's local storage instead.
EXPO_PUBLIC_ATOM_SYNC_TOKEN=replace-with-a-long-random-token
# 口语复盘（念稿练习）的服务地址。不设 = 库只读：能看能听（不含云上音频），不能录不能评。
# 口令复用上面那个 ATOM_SYNC_TOKEN，不再单独配一个。
EXPO_PUBLIC_ATOM_RECITE_URL=https://YOUR-RECITE-CLOUD-RUN-URL
